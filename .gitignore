# ============================================================
# TeleMedicine AI — Root .gitignore
# ============================================================

# ---------- Secrets & Environment ----------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
id_rsa
id_rsa.pub
*.secret
secrets/

# ---------- Dependencies ----------
node_modules/
jspm_packages/
bower_components/
.pnp/
.pnp.js

# ---------- Build Outputs ----------
dist/
build/
dist-ssr/
*.tsbuildinfo
.next/
out/
output/

# ---------- Python / ML ----------
__pycache__/
*.py[cod]
*$py.class
.Python
.venv/
venv/
env/
ENV/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
*.joblib
*.pkl
*.h5
*.pt
*.onnx
ml/outputs/
ml/models/*.joblib
ml/models/*.pkl

# ---------- Dataset artifacts (raw sensitive data) ----------
datasets/*.csv
datasets/*.json
datasets/*.zip
datasets/data/
datasets/raw/

# ---------- Logs ----------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*_out.txt
*_out.log
tscheck_out.txt
issue*.txt

# ---------- Test / Coverage ----------
coverage/
coverage.*
*.lcov
htmlcov/

# ---------- Editor / IDE ----------
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ---------- OS ----------
.DS_Store
Thumbs.db
Desktop.ini
*.iml

# ---------- Misc / Temp ----------
*.local
*.log.*
tmp/
temp/
.cache/
.env.local
.env.test.local
.env.production.local

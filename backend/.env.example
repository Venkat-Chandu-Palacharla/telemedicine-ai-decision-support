# TeleMedicine AI Backend Environment Configuration
# Copy this file to .env and fill in the values.

# Server
PORT=8080
NODE_ENV=development

# JWT Authentication
# Use a strong secret in production (generate with: openssl rand -hex 32)
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=2h

# Optional PostgreSQL connection (used when enabling persistence)
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/telemed

# Optional MongoDB connection (used when enabling persistence)
# MONGODB_URI=mongodb://localhost:27017/telemed

# CORS origins (comma separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
